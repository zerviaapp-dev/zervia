# Zervia — environment variables (Phase 6)
# Copy to `.env.local` and fill in. NEVER commit real values.

# --- Site URL (auth email redirects) --------------------------------------
# Canonical production URL — used as the fallback for auth email redirect
# links (signup confirmation, magic link, password reset) when the Origin
# header is missing from the server action. Must match the Supabase
# dashboard → Authentication → URL Configuration → Site URL.
NEXT_PUBLIC_SITE_URL=https://zervia-app-deploy.vercel.app

# --- Upstash Redis (rate limiting, production) ---------------------------
# Distributed rate limiting for serverless. Get free credentials at
# https://upstash.com → Create Redis database → REST API → copy these.
# When set, lib/rate-limit.ts uses atomic Redis counters across all
# Vercel instances. When unset, it falls back to in-memory buckets
# (correct locally; per-instance on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Supabase (required for real accounts) -------------------------------
# Founder task (10 minutes): create a free project at https://supabase.com
# → Project Settings → API → copy these two values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — for the Stripe webhook handler ONLY. It bypasses RLS,
# so it must NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix) and
# NEVER be committed. Same Supabase dashboard page as above.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (Phase 6 — bot protection, enforced) -----------
# Get free keys at https://dash.cloudflare.com → Turnstile → Add widget.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY renders the widget on the signup form.
# TURNSTILE_SECRET_KEY verifies tokens server-side. PRODUCTION FAILS CLOSED:
# if the secret is missing in production, signup is rejected rather than
# silently unprotected (see lib/turnstile.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Web push / PWA (Phase 6 — sending is post-launch) --------------------
# VAPID keys for web-push notifications. Generate once:
#   npx web-push generate-vapid-keys
# The public key ships to browsers; the private key stays server-side.
# Push SENDING is stubbed until post-launch (see PHASE-6-REPORT.md).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@zervia.app

# --- Stripe (Phase 5 — Money) ---------------------------------------------
# Founder task: create a Stripe account at https://stripe.com, then follow
# supabase/stripe-setup.md to create the products and get these values.
# Start with TEST keys (sk_test_..., pk_test_...). Go live only when the
# founder explicitly approves: swap to sk_live_/pk_live_ and set
# STRIPE_TEST_MODE=false.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret: Stripe Dashboard → Developers → Webhooks →
# "Add endpoint" → select events → "Reveal" signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Price IDs from the Stripe products you create (supabase/stripe-setup.md).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_BOOST=
# One-time purchases (no subscription): create these products in the Stripe
# dashboard as one-time prices, then set the IDs here.
STRIPE_PRICE_VERIFICATION_BADGE=
STRIPE_PRICE_FEATURED_WEEK=
STRIPE_PRICE_PROFILE_SPOTLIGHT=
# Optional per-currency prices for multi-currency checkout (USD/PHP).
# Create matching products in the Stripe dashboard (same tiers, priced in
# USD / PHP), then set these. When unset, non-CAD buyers fall back to the
# CAD price above and are charged in CAD.
# STRIPE_PRICE_PRO_MONTHLY_USD=
# STRIPE_PRICE_PRO_YEARLY_USD=
# STRIPE_PRICE_BUSINESS_MONTHLY_USD=
# STRIPE_PRICE_BUSINESS_YEARLY_USD=
# STRIPE_PRICE_BOOST_USD=
# STRIPE_PRICE_VERIFICATION_BADGE_USD=
# STRIPE_PRICE_FEATURED_WEEK_USD=
# STRIPE_PRICE_PROFILE_SPOTLIGHT_USD=
# STRIPE_PRICE_PRO_MONTHLY_PHP=
# STRIPE_PRICE_PRO_YEARLY_PHP=
# STRIPE_PRICE_BUSINESS_MONTHLY_PHP=
# STRIPE_PRICE_BUSINESS_YEARLY_PHP=
# STRIPE_PRICE_BOOST_PHP=
# STRIPE_PRICE_VERIFICATION_BADGE_PHP=
# STRIPE_PRICE_FEATURED_WEEK_PHP=
# STRIPE_PRICE_PROFILE_SPOTLIGHT_PHP=

# true (default) = TEST MODE banner on billing pages; every Stripe call
# uses test keys. Set to "false" ONLY when going live with real money.
STRIPE_TEST_MODE=true

# Set to "true" AFTER enabling Apple Pay + Google Pay in the Stripe
# Dashboard → Settings → Payments → Payment methods → Wallets.
# Stripe Checkout then offers them automatically on supported devices
# (Safari/iPhone for Apple Pay, Chrome/Android for Google Pay) — no
# code changes needed. Until then, buyers see card + PayPal only.
STRIPE_WALLETS_ENABLED=false

# --- PayPal (one-time purchases + memberships, alongside Stripe) ---------
# Founder task: create a PayPal Business account at https://paypal.com,
# then https://developer.paypal.com → Apps & Credentials → create a
# REST API app. Start in SANDBOX (test). Go live only when the founder
# explicitly approves: create a LIVE app, swap the credentials, and set
# PAYPAL_MODE=live.
#
# One-time purchases (featured boost $9, verification badge $29,
# featured week $15, profile spotlight $19) use the Orders API and need
# no extra setup — amounts come from server constants (lib/pricing.ts).
#
# Memberships (pro/business) need billing PLANS created once in the
# PayPal dashboard (Pay & Get Paid → Subscriptions → Plans); paste the
# plan IDs below. Without them, PayPal subscription checkout returns
# `plan_not_configured` and buyers use Stripe instead.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=<redacted>
# Webhook: developer.paypal.com → your app → Webhooks →
# "Add webhook" → URL https://zervia.app/api/paypal/webhook →
# subscribe to: PAYMENT.CAPTURE.COMPLETED,
# BILLING.SUBSCRIPTION.ACTIVATED, BILLING.SUBSCRIPTION.CANCELLED,
# BILLING.SUBSCRIPTION.SUSPENDED, BILLING.SUBSCRIPTION.PAYMENT.FAILED
# → paste the webhook ID here (used to verify event signatures).
PAYPAL_WEBHOOK_ID=
# Optional: PayPal subscription plan IDs (create in PayPal dashboard).
# PAYPAL_PLAN_PRO_MONTHLY=
# PAYPAL_PLAN_PRO_YEARLY=
# PAYPAL_PLAN_BUSINESS_MONTHLY=
# PAYPAL_PLAN_BUSINESS_YEARLY=

# --- CJ Dropshipping (product marketplace — Phase: products) ---------------
# Get a free API key at https://cjdropshipping.com → My CJ → API.
# When set, product orders are fulfilled automatically via CJ's API.
# When unset, orders queue as "pending_fulfillment" for manual handling
# in the provider dashboard — the shop still works, fulfillment is manual.
CJ_API_KEY=
CJ_API_SECRET=

# --- WhatsApp notifications (Meta WhatsApp Business Cloud API) -------------
# Founder task (~15 min): https://developers.facebook.com → create app →
# add "WhatsApp" product → copy the Phone number ID + token.
# When set, booking updates / reminders / messages / offer alerts go out
# over WhatsApp (lib/whatsapp.ts). When unset, those sends are graceful
# no-ops — the app and in-app notifications keep working.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Set to "true" ONLY after creating approved message templates in WhatsApp
# Manager. Template mode is required for proactive messages outside the
# 24-hour customer-service window (lib/whatsapp.ts documents the mapping).
WHATSAPP_USE_TEMPLATES=false
# Optional template-name overrides (defaults: zervia_booking_confirmed,
# zervia_booking_reminder, zervia_new_message, zervia_offer_alert).
# WHATSAPP_TPL_BOOKING_CONFIRMED=
# WHATSAPP_TPL_BOOKING_REMINDER=
# WHATSAPP_TPL_NEW_MESSAGE=
# WHATSAPP_TPL_OFFER_ALERT=

# --- SMS alerts (Twilio) ---------------------------------------------------
# Founder task (~10 min): https://www.twilio.com/try-twilio → create account
# → buy a phone number → console dashboard → copy Account SID + Auth Token.
# Used for booking confirmations, verification codes, urgent alerts
# (lib/sms.ts). When unset, SMS sends are graceful no-ops.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# --- Product sourcing: AliExpress Open Platform -----------------------------
# Founder task: apply at https://developers.aliexpress.com → create an app →
# copy App Key + App Secret. Powers server-side catalog search on the
# provider sourcing page (lib/aliexpress-sourcing.ts). When unset, search
# returns clearly-marked sample results (no crash).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# --- Product sourcing: 1688.com ----------------------------------------------
# 1688 has no public foreigner-friendly API — the guided import flow
# (lib/sourcing-1688.ts) scrapes pasted product URLs server-side.
# No credentials needed.

# --- Google Maps + Places (Phase 7 — location & reviews) ------------------
# Get a key at https://console.cloud.google.com → APIs & Services →
# Credentials → Create API key. Enable these APIs on the key:
#   Maps JavaScript API (interactive maps), Places API (New) (review import).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY renders maps in the browser (location
# picker, "near me" view). GOOGLE_PLACES_API_KEY stays server-side only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- TikTok Shop (Phase 7 — scaffold, needs business approval) ------------
# Apply at https://partner.tiktokshop.com → become a seller/developer →
# create an app → get credentials. Until approved, the provider dashboard
# shows a "coming soon" panel and all API calls fail gracefully.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ID=
# Access token from the OAuth flow (post-approval). Leave empty until then.
# TIKTOK_ACCESS_TOKEN=

# --- Stripe Identity (Phase 7 — provider ID verification) ----------------
# Reuses STRIPE_SECRET_KEY above. Enable in Stripe Dashboard →
# Settings → Identity (no extra key needed). Webhook events
# identity.verification_session.verified / .requires_input are handled by
# the existing Stripe webhook route (STRIPE_WEBHOOK_SECRET).
